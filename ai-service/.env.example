# =============================================================================
# SeekAndDestroy - AI service configuration
# Copy to .env and adjust. Every value below has a working default, so the
# platform starts with an empty .env as long as SQL Server is reachable.
# =============================================================================

# --- database ---------------------------------------------------------------
# Single source of truth for the connection. The ODBC connection string is
# derived from these; do not duplicate it anywhere else.
SAD_DB__SERVER=LAPTOP-R6U8H616
SAD_DB__DATABASE=PraveenDB
SAD_DB__SCHEMA=sad
SAD_DB__INTEGRATED_SECURITY=true
SAD_DB__ENCRYPT=false
SAD_DB__TRUST_SERVER_CERTIFICATE=false
SAD_DB__POOLING=false
SAD_DB__MULTIPLE_ACTIVE_RESULT_SETS=false
SAD_DB__APPLICATION_NAME=SeekAndDestroy
SAD_DB__COMMAND_TIMEOUT=0
SAD_DB__ODBC_DRIVER=ODBC Driver 17 for SQL Server
# Only used when SAD_DB__INTEGRATED_SECURITY=false
SAD_DB__USERNAME=
SAD_DB__PASSWORD=

# --- auth ---------------------------------------------------------------------
# local | oidc. local (default): this service issues its own signed dev tokens
# via POST /api/auth/dev-token (against a real, active Employee row) - no
# external identity provider needed. oidc: validate tokens from a real IdP
# (Azure AD/Entra, Okta, ...) via JWKS; this service never issues tokens itself
# in that mode, and /api/auth/dev-token returns 404.
SAD_AUTH__MODE=local
# local mode only. CHANGE THIS in any shared/deployed environment - the value
# below is a placeholder, not a secret. Must match exactly on the .NET gateway
# (Auth__LocalSigningKey) and any MCP server validating tokens, since it's a
# symmetric key both sides sign/verify with.
SAD_AUTH__LOCAL_SIGNING_KEY=dev-only-insecure-signing-key-change-me
SAD_AUTH__LOCAL_TOKEN_TTL_MINUTES=60
SAD_AUTH__ALGORITHM_LOCAL=HS256
# oidc mode only. oidc_jwks_url is derived from oidc_authority if left blank
# (standard {authority}/.well-known/jwks.json).
SAD_AUTH__OIDC_AUTHORITY=
SAD_AUTH__OIDC_AUDIENCE=
SAD_AUTH__OIDC_JWKS_URL=

# --- llm --------------------------------------------------------------------
# mock | openai | azure-openai | ollama | gemini
#
# "mock" is an offline development fallback, NOT a target state - it emits
# placeholder narration. Configure a real provider for anything you intend to
# evaluate. "gemini" speaks Google's native generateContent API and supports
# server-side structured output (responseSchema), so a schema field cannot be
# silently omitted the way prompt-based format instructions allow.
#
# Gemini model names: use a *-latest alias, never a pinned version. Pinned
# versions get closed to new keys and answer 404 "no longer available to new
# users", which is indistinguishable from a wrong model name or a bad key.
#   gemini-flash-latest       fast, cheapest
#   gemini-flash-lite-latest  fastest, separate daily quota
#   gemini-pro-latest         highest quality
SAD_LLM__PROVIDER=mock
SAD_LLM__MODEL=seek-and-destroy-mock
SAD_LLM__TEMPERATURE=0.0
SAD_LLM__MAX_OUTPUT_TOKENS=2048
SAD_LLM__TIMEOUT_SECONDS=60
SAD_LLM__BASE_URL=
SAD_LLM__API_KEY=
SAD_LLM__AZURE_ENDPOINT=
SAD_LLM__AZURE_DEPLOYMENT=
SAD_LLM__AZURE_API_VERSION=2024-10-21
SAD_LLM__OLLAMA_BASE_URL=http://localhost:11434
# Hard limit on characters fed to the model from any single tool result.
SAD_LLM__MAX_INPUT_CHARS=24000
# Multi-LLM: ordered, comma-separated backup providers tried if SAD_LLM__PROVIDER
# raises (e.g. "azure-openai,ollama"). Each fallback reuses the provider-specific
# fields above (azure_endpoint/deployment, ollama_base_url, etc.), so those must
# already be filled in for a listed fallback to actually work. Leave blank to
# disable (default) - a single provider is used with no fallback chain.
SAD_LLM__FALLBACK_PROVIDERS=
# Spend/abuse control: max real (non-mock) chat-model calls per UTC calendar
# day, process-wide (shared across workers when SAD_CACHE__BACKEND=redis).
# 0 (default) = unlimited. Mock mode is always unlimited - it costs nothing.
SAD_LLM__DAILY_CALL_BUDGET=0

# --- retrieval --------------------------------------------------------------
# qdrant | memory   (memory keeps everything in-process; no server needed)
SAD_RETRIEVAL__BACKEND=memory
SAD_RETRIEVAL__QDRANT_URL=http://localhost:6333
SAD_RETRIEVAL__QDRANT_API_KEY=
SAD_RETRIEVAL__COLLECTION=seekanddestroy
# hash | sentence-transformers | api | gemini
SAD_RETRIEVAL__EMBEDDING_PROVIDER=hash
SAD_RETRIEVAL__EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SAD_RETRIEVAL__EMBEDDING_DIMENSIONS=384
# "api" provider: any OpenAI-compatible /v1/embeddings endpoint. Set EMBEDDING_MODEL
# to a real model name too (e.g. text-embedding-3-small) - the default above is a
# sentence-transformers name and won't resolve against a real API. Leave
# EMBEDDING_BASE_URL blank for OpenAI's default. For Azure OpenAI, set
# EMBEDDING_BASE_URL to the full deployment URL and EMBEDDING_API_VERSION (this
# switches auth to the api-key header instead of Authorization: Bearer). For
# Ollama, EMBEDDING_BASE_URL=http://localhost:11434/v1.
# "gemini" provider: Google's native embeddings API (a different wire format from
# "api", so it's a separate client - app/retrieval/gemini_embedder.py). Set
# EMBEDDING_MODEL=gemini-embedding-001 (or another Gemini embedding model) and
# EMBEDDING_API_KEY to a Gemini API key. EMBEDDING_BASE_URL/EMBEDDING_API_VERSION
# are unused by this provider.
SAD_RETRIEVAL__EMBEDDING_BASE_URL=
SAD_RETRIEVAL__EMBEDDING_API_KEY=
SAD_RETRIEVAL__EMBEDDING_API_VERSION=
SAD_RETRIEVAL__EMBEDDING_BATCH_SIZE=64
SAD_RETRIEVAL__EMBEDDING_TIMEOUT_SECONDS=30
# Same spend-control pattern as SAD_LLM__DAILY_CALL_BUDGET, for the "api"/"gemini"
# embedding providers. Counts embed_documents/embed_query calls, not texts. 0 = unlimited.
SAD_RETRIEVAL__EMBEDDING_DAILY_CALL_BUDGET=0
SAD_RETRIEVAL__TOP_K=8
# Persist the in-memory vector store between runs (leave blank to disable).
SAD_RETRIEVAL__MEMORY_STORE_PATH=.state/vectors.json

# --- cache --------------------------------------------------------------
# memory | redis   (memory keeps everything in-process; no server needed)
SAD_CACHE__BACKEND=memory
SAD_CACHE__REDIS_URL=redis://localhost:6379/0
SAD_CACHE__DEFAULT_TTL_SECONDS=300

# --- capacity policy --------------------------------------------------------
# NOTE on Gemini free-tier quota, found the hard way: the limit is
# GenerateRequestsPerDayPerProjectPerModel-FreeTier = **20 requests per day**,
# per model, not per minute. One investigation spends ~4 (one per explained
# candidate plus the final report), so roughly five investigations exhausts a
# model for the day. It resets per model, so switching models buys another 20.
# Anything resembling real evaluation work needs billing enabled on the
# Google Cloud project.

SAD_POLICY__CPU_THRESHOLD_PERCENT=75
SAD_POLICY__MEMORY_THRESHOLD_PERCENT=80
SAD_POLICY__STORAGE_THRESHOLD_PERCENT=85
SAD_POLICY__SAFETY_MARGIN_PERCENT=10
SAD_POLICY__UTILIZATION_WINDOW_DAYS=30
SAD_POLICY__GROWTH_HORIZON_YEARS=1
SAD_POLICY__OVERPROVISION_CPU_PERCENT=32
SAD_POLICY__OVERPROVISION_MEMORY_PERCENT=32
SAD_POLICY__UNDERPROVISION_CPU_PERCENT=80
SAD_POLICY__UNDERPROVISION_MEMORY_PERCENT=85
SAD_POLICY__MIN_NODES_TIER1=3
SAD_POLICY__MIN_NODES_TIER2=2
SAD_POLICY__NODE_FAILURE_TOLERANCE=1

# --- recommendation shortlist -----------------------------------------------
# How much of the ranking is proposed for human review: the top N clusters, and
# the top M hosts inside each. Ranking itself is never truncated.
SAD_POLICY__TOP_CLUSTERS=3
SAD_POLICY__TOP_NODES_PER_CLUSTER=3
# NODE-004: a host may lag the freshest host in its own cluster by this many
# days before it stops being recommendable (relative, not wall-clock).
SAD_POLICY__NODE_STALE_AFTER_DAYS=7
SAD_POLICY__NODE_INCIDENT_WINDOW_DAYS=90

# --- scoring weights (must sum to 1.0) --------------------------------------
SAD_SCORING__WEIGHT_CAPACITY=0.30
SAD_SCORING__WEIGHT_COMPATIBILITY=0.15
SAD_SCORING__WEIGHT_RESILIENCY=0.15
SAD_SCORING__WEIGHT_COST=0.15
SAD_SCORING__WEIGHT_DEPENDENCY=0.10
SAD_SCORING__WEIGHT_HISTORICAL=0.10
SAD_SCORING__WEIGHT_RISK=0.05
SAD_SCORING__MIN_CONFIDENT_SCORE=55

# --- node scoring weights (must sum to 1.0, validated separately) ------------
# Four terms, not seven: compatibility, resiliency tier and dependency locality
# are cluster properties identical across sibling hosts, so they order clusters
# but cannot order hosts within one. See docs/scoring-model.md.
SAD_SCORING__NODE_WEIGHT_CAPACITY=0.50
SAD_SCORING__NODE_WEIGHT_COST=0.20
SAD_SCORING__NODE_WEIGHT_RELIABILITY=0.20
SAD_SCORING__NODE_WEIGHT_RISK=0.10

# --- forecasting ------------------------------------------------------------
SAD_FORECAST__DEFAULT_HORIZON_DAYS=90
SAD_FORECAST__MIN_HISTORY_DAYS=14
SAD_FORECAST__CONFIDENCE_Z=1.96

# --- service ----------------------------------------------------------------
SAD_SERVICE__HOST=127.0.0.1
SAD_SERVICE__PORT=8088
SAD_SERVICE__LOG_LEVEL=INFO
SAD_SERVICE__LOG_JSON=false
SAD_SERVICE__CHECKPOINT_PATH=.state/checkpoints.db
SAD_SERVICE__MAX_QUERY_CHARS=2000
SAD_SERVICE__MAX_ROWS=500

# --- observability (optional) ----------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=seek-and-destroy
