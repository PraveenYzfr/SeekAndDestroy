# Deployment variables read by docker/docker-compose.yml.
#
#   copy to docker/.env  ->  docker compose reads it automatically
#
# docker/.env is gitignored. Nothing in this file belongs in the repository
# with real values filled in.
#
# Every variable here has a safe default in docker-compose.yml that is correct
# for a laptop and wrong for a deployed host. The four marked REQUIRED FOR
# DEPLOYMENT are the ones whose defaults are actively unsafe once the host is
# reachable by anyone but you.
#
# LOCAL MUST MATCH PRODUCTION
# ---------------------------
# The defaults in docker-compose.yml are now the values the VM uses, not
# laptop-friendly stand-ins. That change was paid for: three bugs in the first
# real deployment were structurally UNREACHABLE locally because the defaults
# differed.
#
#   * SAD_LLM__PROVIDER defaulted to "mock", so a local stack narrated from a
#     canned model while looking identical to production - and passed every
#     health check doing it. It now has no default and the stack refuses to
#     start without one. Set it to "mock" explicitly if that is what you want.
#   * Embeddings defaulted to hash/384. A full reindex with real gemini/3072
#     vectors serialises to 96 MB and exceeds Qdrant's 32 MiB request cap;
#     384-dimension vectors never come close. The bug could not be reproduced
#     locally at any effort.
#   * The two are also different similarity spaces, so a local index and a
#     production index were never comparable.
#
# To reproduce a production problem locally, copy the VM's values for the LLM
# and embedding blocks below. Everything else - its own SQL Server, Qdrant and
# Redis rather than the shared hub ones - is a difference that does not change
# application behaviour.

# --- database ---------------------------------------------------------------
# By default the stack runs its OWN SQL Server container and initialises it
# (schema + migrations + seed + least-privilege login) on first start. Nothing
# on the host is touched, and the container image is SQL-auth only, so there is
# no Mixed Mode to enable.
#
# REQUIRED. SQL Server refuses to start on a weak sa password and the failure
# is buried in `docker logs sqlserver`: 8+ chars with upper, lower, digit and
# symbol.
SAD_SA_PASSWORD=

# The application login the services connect as - created by db-init with
# SELECT on the sad schema and INSERT/UPDATE on only the five governance
# tables the platform writes. Never sa.
SAD_DB_USERNAME=sad_app
SAD_DB_PASSWORD=

# Point at an external SQL Server instead of the container. On Windows/Mac
# Docker Desktop that is host.docker.internal; on a Linux host use the host's
# LAN address. Leave unset to use the container.
#SAD_DB_HOST=host.docker.internal

# Host port for SSMS/Azure Data Studio. 14330 rather than 1433 so it cannot
# collide with a SQL Server already installed on the machine. Bound to
# loopback - on a VM, reach it with an SSH tunnel, never an NSG rule:
#   ssh -L 14330:localhost:14330 azureuser@<vm-ip>
#
# Connect as  127.0.0.1,14330  - NOT  localhost,14330. Docker publishes the
# port on IPv4 only, while "localhost" resolves to IPv6 ::1 first on Windows,
# so the connection sits there until it times out with a misleading "server is
# not found or not accessible".
SAD_SA_HOST_PORT=14330

# --- authentication ---------------------------------------------------------
# REQUIRED FOR DEPLOYMENT. The compose default is the literal string
# "dev-only-insecure-signing-key-change-me", which is published in this
# repository - anyone can mint a valid token for any employee against a host
# still using it, including tokens that approve recommendations. Generate one:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# It must be identical for ai-service and api-gateway or they reject each
# other's tokens.
SAD_AUTH_MODE=local
SAD_AUTH_LOCAL_SIGNING_KEY=

# Entra ID / Okta / any OIDC provider. Setting mode=oidc disables both
# /api/auth/login and /api/auth/dev-token (404) - tokens then come only from
# the provider, and there is no local way in.
SAD_AUTH_OIDC_AUTHORITY=
SAD_AUTH_OIDC_AUDIENCE=

# --- vector store -----------------------------------------------------------
# REQUIRED FOR DEPLOYMENT. Qdrant has no authentication by default. Compose
# binds it to loopback, but set this too so an accidental port exposure is not
# immediately an open database.
SAD_QDRANT_API_KEY=

# --- embeddings -------------------------------------------------------------
# ai-service/.env is excluded from the image (.dockerignore), so a real
# provider's key has to be injected here rather than baked into a layer.
# Unset means the offline hash embedder: no API calls, no cost, lower quality.
#   gemini  -> gemini-embedding-001, 3072 dims
#   api     -> any OpenAI-compatible /v1/embeddings endpoint
SAD_EMBEDDING_PROVIDER=hash
SAD_EMBEDDING_MODEL=
SAD_EMBEDDING_API_KEY=
SAD_EMBEDDING_DIMENSIONS=384

# --- observability ----------------------------------------------------------
# REQUIRED FOR DEPLOYMENT (both). Grafana defaults to anonymous viewer access
# and the admin/admin password - fine on a laptop, an open door on a VM.
SAD_GRAFANA_ANONYMOUS=false
SAD_GRAFANA_ADMIN_PASSWORD=


# --- LLM (no default for the provider - see LOCAL MUST MATCH PRODUCTION) -----
# What the VM runs today. Keys live in ai-service/.env; copy the values across.
SAD_LLM_PROVIDER=deepseek
SAD_LLM_MODEL=deepseek-v4-flash
SAD_LLM_API_KEY=
# DeepSeek V4 reasons before answering, and the 2048 default is consumed
# entirely by that reasoning - the API then returns 200 with EMPTY content and
# finish_reason=length, which reads like a broken model rather than a budget.
SAD_LLM_MAX_OUTPUT_TOKENS=8192
# Runaway-loop guard, not a spend control. It is NOT a graceful limit:
# BudgetExceededError is caught nowhere, so hitting it fails the request
# with an unhandled 500 in front of whoever is watching.
# 100 was the old default and is ~12 investigations - it would end a demo.
# 50000 at ~0.10 INR/call is ~5,000 INR worst case, which is the stated
# tolerance, and still stops a loop long before it drains the account.
SAD_LLM_DAILY_CALL_BUDGET=50000
# For any OpenAI-compatible endpoint (Groq, Together, Fireworks): set
# SAD_LLM_PROVIDER=openai plus a base URL, and a label so its metrics and
# cache key are attributed to the real vendor rather than filed under "openai".
#SAD_LLM_BASE_URL=https://api.groq.com/openai/v1
#SAD_LLM_PROVIDER_LABEL=groq

# --- embeddings (defaults now match the VM) ---------------------------------
SAD_EMBEDDING_PROVIDER=gemini
SAD_EMBEDDING_MODEL=gemini-embedding-001
SAD_EMBEDDING_API_KEY=
SAD_EMBEDDING_DIMENSIONS=3072

# --- LangGraph checkpointer -------------------------------------------------
# Where a paused investigation lives between interrupt() and resume. Blank
# falls back to SQLite, which is single-process only: two replicas mean two
# files, and an Approve landing on the wrong one finds no thread at all.
SAD_CACHE__CHECKPOINT_REDIS_URL=redis://redis:6379/1

# Per-provider credentials. SAD_LLM_API_KEY above is process-wide and is used
# for any provider without an entry here, so a single-provider deployment can
# ignore this block entirely.
#
# They exist because a role override can point one chain at a different
# PROVIDER, not just a different model. Without a credential per provider the
# factory builds the new provider's client with the default provider's key and
# returns 401 - a failure that reads as a bad key rather than a missing feature.
SAD_LLM_PROVIDER_KEY_DEEPSEEK=
SAD_LLM_PROVIDER_KEY_GROQ=
